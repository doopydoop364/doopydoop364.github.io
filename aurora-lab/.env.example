# Live runs only. Never copy real keys into company/, prompts/, scenarios/, or runs/.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional per-million-token pricing supplied by the operator; unknown prices report null.
AURORA_INPUT_USD_PER_MILLION=
AURORA_OUTPUT_USD_PER_MILLION=
# Optional Phase 4.4 local, loopback-only extractive summary selector.
AURORA_LOCAL_SUMMARY_URL=
AURORA_LOCAL_SUMMARY_MODEL=
# Optional bearer token for a loopback OpenAI-compatible employee endpoint
# such as Unsloth Studio. Leave UNSET for an unauthenticated local server.
# UNSLOTH_API_KEY=
# Optional cloud employee inference. Configure both rates for each selected backend.
# Cloud employee inference also requires explicit dashboard confirmation or the CLI
# --allow-employee-api-charges flag and a positive employee cloud budget.
AURORA_EMPLOYEE_OPENAI_INPUT_USD_PER_MILLION=
AURORA_EMPLOYEE_OPENAI_OUTPUT_USD_PER_MILLION=
AURORA_EMPLOYEE_ANTHROPIC_INPUT_USD_PER_MILLION=
AURORA_EMPLOYEE_ANTHROPIC_OUTPUT_USD_PER_MILLION=
